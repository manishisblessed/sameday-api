# Same Day Solution — POS Partner API Portal
# Copy this file to .env.local and fill in your real credentials
# NEVER commit .env.local to version control

API_BASE_URL=https://api.samedaysolution.in
# Must include payout (or all) permission for Settlement / payout APIs — not only POS
# Must include bbps (or all) permission for BBPS Bill Payment APIs
API_KEY=pk_live_YOUR_API_KEY_HERE
API_SECRET=sk_live_YOUR_API_SECRET_HERE

# Password gate for Settlement/Payout dashboard — leave empty or remove to disable
SETTLEMENT_PASSWORD=

# Password gate for the credit-card dashboards — BBPS Bill Payment, BBPS-2 (Pay2New)
# and Credit Card-2 (RechargeKit). Leave empty or remove to disable the gate.
# Requires the CC-2 (RechargeKit) service to be enabled + server IP whitelisted by admin.
BBPS_PASSWORD=

# Note (v3.0): PAYOUT_PARTNER_ID is no longer needed — payouts debit your partner wallet directly

# ─── Payout v3.0 — DB-backed pending job ─────────────────────────────────────
# Secret token for the GET /api/payout/poll-pending cron endpoint.
# Set to any strong random string; leave empty to disable the endpoint.
# Call the endpoint with:  Authorization: Bearer <POLL_SECRET>
POLL_SECRET=

# SQLite DB file is stored at ./data/payout.db (created automatically).
# Requires Node ≥ 22.12 (uses built-in node:sqlite — no native compilation needed).
# NOTE — Vercel / serverless: swap src/lib/payout-db.ts for a cloud DB adapter
#        (Neon, Turso, PlanetScale) while keeping the same exported interface.
# PAYOUT_DB_PATH=./data/payout.db
